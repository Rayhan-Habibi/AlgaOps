# --- Build output (C core, firmware host tests, CMake) ---
build/
*.o
*.obj
*.exe
*.a
*.lib
*.dll
*.dylib
*.so
*.pdb
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
wheelhouse/

# --- Dashboard (built by `npm run build`, served by the gateway) ---
node_modules/
dashboard/dist/
dashboard/test-results/
dashboard/playwright-report/

# --- ESP-IDF (local configuration holds Wi-Fi / MQTT credentials) ---
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/managed_components/
firmware/**/dependencies.lock

# --- Gateway runtime data and secrets ---
var/
*.db
*.db-wal
*.db-shm
gateway/config/gateway.toml
deploy/docker/secrets/
*.token
*_password
passwd
*.pem
*.key

# --- Recorded field data stays local unless explicitly published ---
data/hardware/*
!data/hardware/.gitkeep

# --- Output / temporary files ---
results.csv
*.tmp
*.log
scratch/

# --- IDE / editor ---
.vscode/
.vs/
.idea/
*.swp
*~
.claude/settings.local.json
